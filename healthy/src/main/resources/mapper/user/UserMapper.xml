<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yizl.healthy.user.mapper.UserMapper">

    <resultMap id="userEntityResultMap" type="com.yizl.healthy.user.entity.UserEntity">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="phone" column="phone"/>
        <result property="gender" column="gender"/>
        <result property="role" column="role"/>
        <result property="status" column="status"/>
        <result property="avatar_path" column="avatar_path"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="userQueryWhere">
        <where>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="phone != null and phone != ''">
                AND phone = #{phone}
            </if>
            <if test="gender != null and gender != ''">
                AND gender = #{gender}
            </if>
            <if test="role != null and role != ''">
                AND role = #{role}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
    </sql>

    <select id="countByCondition"
            parameterType="com.yizl.healthy.user.mapper.param.UserQueryCondition"
            resultType="long">
        SELECT COUNT(*)
        FROM `user`
        <include refid="userQueryWhere"/>
    </select>

    <select id="selectPageByCondition"
            parameterType="com.yizl.healthy.user.mapper.param.UserQueryCondition"
            resultMap="userEntityResultMap">
        SELECT id,
               name,
               phone,
               gender,
               role,
               status,
               avatar_path,
               create_time
        FROM `user`
        <include refid="userQueryWhere"/>
        ORDER BY id DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="countByPhoneExcludingId" resultType="long">
        SELECT COUNT(*)
        FROM `user`
        WHERE phone = #{phone}
        <if test="excludedUserId != null">
            AND id != #{excludedUserId}
        </if>
    </select>

</mapper>
