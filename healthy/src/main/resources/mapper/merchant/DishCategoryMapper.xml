<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yizl.healthy.merchant.mapper.DishCategoryMapper">

    <resultMap id="dishCategoryRowMap"
               type="com.yizl.healthy.merchant.mapper.row.DishCategoryRow">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="initialSort" column="initial_sort"/>
        <result property="nutritionTagsJson" column="nutrition_tags_json"/>
    </resultMap>

    <select id="selectAllWithNutritionTags" resultMap="dishCategoryRowMap">
        SELECT dc.id,
               dc.name,
               dc.initial_sort,
               (
                   SELECT JSON_ARRAYAGG(cn.nutrition_tag)
                   FROM category_nutrition cn
                   WHERE cn.category_id = dc.id
               ) AS nutrition_tags_json
        FROM dish_category dc
        ORDER BY dc.initial_sort ASC, dc.id ASC
    </select>

    <select id="selectNutritionTags" resultType="java.lang.String">
        SELECT nutrition_tag
        FROM category_nutrition
        WHERE category_id = #{categoryId}
        ORDER BY id ASC
    </select>
</mapper>
